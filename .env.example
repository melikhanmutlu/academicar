# Application Setup
APP_ENV=development
FLASK_DEBUG=1
SECRET_KEY=generate_a_secure_random_key_here

# Bootstrap admin accounts (comma-separated emails). These accounts are
# auto-promoted to admin on startup. No admin email is hardcoded in source.
ADMIN_EMAILS=

# Development-only instant plan upgrade (no real payment gateway). Outside
# production this defaults to enabled; in production it is DISABLED unless you
# set ALLOW_DEV_PAYMENTS=1. Never enable in production with real users until a
# real payment provider is integrated.
# ALLOW_DEV_PAYMENTS=0

# Payment provider (provider-agnostic skeleton, see payments.py). Leave empty to
# auto-pick: "development" when ALLOW_DEV_PAYMENTS is on, else "lemonsqueezy".
# For production choose a Merchant of Record so global VAT/tax + invoices are
# handled for you (recommended: lemonsqueezy; fallback: paddle).
# PAYMENT_PROVIDER=development
# PAYMENT_CURRENCY=USD
# PayTR (Turkish gateway). Set PAYMENT_PROVIDER=paytr and point the PayTR panel's
# notification (Bildirim) URL at <SITE_URL>/payment/webhook/paytr.
# PAYTR_MERCHANT_ID=
# PAYTR_MERCHANT_KEY=
# PAYTR_MERCHANT_SALT=
# PAYTR_TEST_MODE=0
# LEMONSQUEEZY_API_KEY=
# LEMONSQUEEZY_STORE_ID=
# LEMONSQUEEZY_WEBHOOK_SECRET=
# LEMONSQUEEZY_VARIANT_ACADEMIC=
# LEMONSQUEEZY_VARIANT_EXTENDED=

# Database Configuration
# DATABASE_URL=postgresql://user:password@localhost:5432/academic_ar
DATABASE_URL=

# Redis (production/shared rate limits; optional locally)
REDIS_URL=redis://localhost:6379/0
# Local development can leave this as memory://. Railway/production should set it to REDIS_URL.
RATELIMIT_STORAGE_URI=memory://

# Storage Provider Configurations
STORAGE_PROVIDER=railway_volume

# File Directories (Relative to app root or absolute)
UPLOAD_FOLDER=uploads
CONVERTED_FOLDER=converted
QR_FOLDER=qr_codes
PDF_FOLDER=pdfs
# BLOG_IMAGE_FOLDER=blog_images
# In Railway, attach a Volume and set STORAGE_ROOT to its mount path
# (or rely on RAILWAY_VOLUME_MOUNT_PATH when available).
STORAGE_ROOT=storage

# S3-compatible durable mirror. The local volume stays the primary read/write
# path (Railway is unchanged); every file is also mirrored to object storage and
# restored on demand if the local copy is missing (e.g. after a volume recycle).
# Leave these empty to disable the mirror entirely (pure local storage).
#
# Cloudflare R2: set R2_ACCOUNT_ID (endpoint is derived automatically).
# R2_ACCOUNT_ID=
#
# Backblaze B2 (or any other S3 provider): set the endpoint + region instead.
# Private buckets on B2 need no credit card. Get the endpoint/region from the
# bucket page and create a non-master Application Key with read/write access.
# R2_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com
# R2_REGION=us-west-004
#
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=academicar-backup

# Upload Limits (in bytes)
MAX_CONTENT_LENGTH=272629760

# Local development can process conversion jobs inline so uploads appear immediately.
# Railway/production ignores DEV_INLINE_JOBS by default; run worker.py separately.
# Only set ALLOW_PRODUCTION_INLINE_JOBS=1 for emergency single-process debugging.
DEV_INLINE_JOBS=1

# Rate Limiting
UPLOAD_RATE_LIMIT_COUNT=5
UPLOAD_RATE_LIMIT_WINDOW=600

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here

# Custom Domains / Routing
SITE_URL=http://localhost:5000

# Google Search Console ownership verification (Search Console → Settings →
# Ownership verification → HTML tag method). Paste just the content value.
# GOOGLE_SITE_VERIFICATION=

# Session / "remember me" cookie lifetime (SEC-9). Defaults to SESSION_LIFETIME_DAYS.
# SESSION_LIFETIME_DAYS=14
# REMEMBER_COOKIE_DAYS=14

# Contact email advertised to external scholarly APIs (Crossref polite pool, SEC-7).
CONTACT_EMAIL=info@academicar.com

# Transactional email / SMTP (SEC-5: email-change confirmation). If MAIL_SERVER
# is empty the app logs the confirmation link instead of sending it (dev mode).
# MAIL_SERVER=smtp.example.com
# MAIL_PORT=587
# MAIL_USE_TLS=1
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_DEFAULT_SENDER=no-reply@academicar.com

# Embeddable viewer (SEC-4). CSP frame-ancestors used ONLY for /view/<id>?embed=1.
# Default "*" lets the read-only 3D widget be embedded anywhere; set a
# space-separated allowlist (e.g. "'self' https://uni.edu") to restrict it.
# EMBED_FRAME_ANCESTORS=*

# Mesh complexity caps (SEC-6/PERF-3). Reject uploads larger than these to
# protect the conversion worker from OOM. 0 disables a given check.
# MAX_MESH_FACES=2000000
# MAX_MESH_VERTICES=2000000

# Worker Settings
# WORKER_POLL_INTERVAL=2

# Reverse Proxy (ProxyFix hops for X-Forwarded-For behind Railway/nginx)
# PROXY_FIX_HOPS=1

# External converter timeout in seconds (OBJ/FBX to GLB)
# MODEL_CONVERT_TIMEOUT=300

# Logging level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO

# Content-Security-Policy (CSP_ENABLED=0 to disable, CSP_REPORT_ONLY=1 for report-only mode)
# CSP_ENABLED=1
# CSP_REPORT_ONLY=0

# Legal / Compliance
# TERMS_VERSION=1.0

# Password minimum length (shared by registration and account password change)
# PASSWORD_MIN_LENGTH=8

# CSRF token lifetime in seconds
# WTF_CSRF_TIME_LIMIT=3600
